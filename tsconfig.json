{
  "compilerOptions": {
    "outDir": "lib",
    "esModuleInterop": true,
    "module": "commonjs",
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es6",
    "sourceMap": true,
    "baseUrl": "./",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true
  },
  "include": [
    "src/*",
    "src/detectors/isCircleIntersectsCircle.ts",
    "src/detectors/isCircleIntersectsLine.ts",
    "src/detectors/isPointIntersectsCircle.ts",
    "src/detectors/isRectInsideRect.ts",
    "src/detectors/isRectIntersectsCircle.ts",
    "src/detectors/isRectIntersectsRect.ts"
  ],
  "exclude": ["node_modules"]
}
